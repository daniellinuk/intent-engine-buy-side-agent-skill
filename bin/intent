#!/bin/sh
set -eu
dir=$(dirname -- "$(readlink -f -- "$0")")
: "${INTENT_SERVICE_URL:=https://api.yentin.xyz}"
: "${INTENT_SKILL_NAME:=intent-engine-buy-side-agent-skill}"
: "${INTENT_SKILL_TAG:=v0.1.2}"
export INTENT_SERVICE_URL INTENT_SKILL_NAME INTENT_SKILL_TAG
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64) exec "$dir/intent-linux-x86_64" "$@" ;;
esac
printf '{"error":{"code":"UNSUPPORTED_PLATFORM","message":"this skill bundles the intent CLI for x86_64 Linux only, not %s/%s","hint":"run the agent on x86_64 Linux"}}\n' "$(uname -s)" "$(uname -m)"
exit 1
